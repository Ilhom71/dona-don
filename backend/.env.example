# PostgreSQL ulanish satri
DATABASE_URL=postgresql://user:password@localhost:5432/donadon

# JWT tokenlarni imzolash uchun maxfiy kalit (kamida 32 ta belgi)
JWT_SECRET=change-this-to-a-long-random-secret

# Server porti
PORT=4000

# Frontend manzili (CORS uchun)
FRONTEND_ORIGIN=http://localhost:3000

# TextUP SMS xizmati (hamkorlarga SMS yuborish uchun) - https://textup.uz
# hisobingizning login email/parolini kiriting
TEXTUP_EMAIL=your-email@example.com
TEXTUP_PASSWORD=change-this

# SMS bo'limidagi "Admin" (SMS kredit to'ldirish) qismiga kirish uchun login/
# parol .env orqali EMAS - to'g'ridan-to'g'ri bazaga quyidagi buyruq bilan
# o'rnatiladi (login mavjud bo'lmasa yaratadi, mavjud bo'lsa parolini
# yangilaydi):
#   bun run sms-admin:set -- <username> <password>
