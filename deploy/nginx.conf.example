# Nginx sayt konfiguratsiyasi - Donadon
# Serverda: /etc/nginx/sites-available/donadon nomi bilan saqlang, so'ng
# /etc/nginx/sites-enabled/ ga symlink qiling (pastdagi qo'llanmaga qarang).
#
# "domeningiz.uz" o'rniga o'z domeningizni yozing.

server {
    listen 80;
    server_name domeningiz.uz www.domeningiz.uz;

    # Backend (Bun/Hono) - /api/ prefiksi olib tashlanib 4000-portga uzatiladi,
    # shunda frontend bilan bir xil origin (CORS kerak emas).
    location /api/ {
        proxy_pass http://127.0.0.1:4000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Frontend (Next.js)
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
